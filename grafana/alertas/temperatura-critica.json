{
    "apiVersion": 1,
    "groups": [
        {
            "orgId": 1,
            "name": "SmartFactory - Monitorizacion",
            "folder": "SmartFactory - Alertas",
            "interval": "1m",
            "rules": [
                {
                    "uid": "eg523gm8khvy8d",
                    "title": "SmartFactory - Temperatura critica",
                    "condition": "C",
                    "data": [
                        {
                            "refId": "A",
                            "relativeTimeRange": {
                                "from": 600,
                                "to": 0
                            },
                            "datasourceUid": "bg5062lsmj6yob",
                            "model": {
                                "intervalMs": 1000,
                                "maxDataPoints": 43200,
                                "query": "from(bucket: \"BHC_TFG\")\r\n  |> range(start: -5m)\r\n  |> filter(fn: (r) => r._measurement == \"maquinas\")\r\n  |> filter(fn: (r) => r._field == \"temperatura\")\r\n  |> group(columns: [\"nombre\"])\r\n  |> last()\r\n  |> keep(columns: [\"_time\", \"_value\", \"nombre\"])\r\n  |> group()\r\n  |> pivot(\r\n      rowKey: [\"_time\"],\r\n      columnKey: [\"nombre\"],\r\n      valueColumn: \"_value\"\r\n  )",
                                "refId": "A"
                            }
                        },
                        {
                            "refId": "B",
                            "queryType": "expression",
                            "relativeTimeRange": {
                                "from": 0,
                                "to": 0
                            },
                            "datasourceUid": "__expr__",
                            "model": {
                                "conditions": [
                                    {
                                        "evaluator": {
                                            "params": [],
                                            "type": "gt"
                                        },
                                        "operator": {
                                            "type": "and"
                                        },
                                        "query": {
                                            "params": []
                                        },
                                        "reducer": {
                                            "params": [],
                                            "type": "last"
                                        },
                                        "type": "query"
                                    }
                                ],
                                "datasource": {
                                    "type": "__expr__",
                                    "uid": "__expr__"
                                },
                                "expression": "A",
                                "intervalMs": 1000,
                                "maxDataPoints": 43200,
                                "reducer": "last",
                                "refId": "B",
                                "type": "reduce"
                            }
                        },
                        {
                            "refId": "C",
                            "queryType": "expression",
                            "relativeTimeRange": {
                                "from": 0,
                                "to": 0
                            },
                            "datasourceUid": "__expr__",
                            "model": {
                                "conditions": [
                                    {
                                        "evaluator": {
                                            "params": [
                                                80
                                            ],
                                            "type": "gt"
                                        },
                                        "operator": {
                                            "type": "and"
                                        },
                                        "query": {
                                            "params": [
                                                "C"
                                            ]
                                        },
                                        "reducer": {
                                            "params": [],
                                            "type": "last"
                                        },
                                        "type": "query"
                                    }
                                ],
                                "datasource": {
                                    "type": "__expr__",
                                    "uid": "__expr__"
                                },
                                "expression": "B",
                                "intervalMs": 1000,
                                "maxDataPoints": 43200,
                                "refId": "C",
                                "type": "threshold"
                            }
                        }
                    ],
                    "noDataState": "NoData",
                    "execErrState": "Error",
                    "annotations": {
                        "description": "Esta alerta supervisa la temperatura de las maquinas industriales simuladas.\n\nSe activa cuando la temperatura de una maquina supera los 80 grados Celsius.\n\nLos datos se reciben mediante MQTT, se almacenan en InfluxDB y son evaluados por Grafana cada minuto.",
                        "summary": "Temperatura critica detectada en SmartFactory"
                    },
                    "labels": {},
                    "isPaused": false,
                    "notification_settings": {
                        "receiver": "empty"
                    }
                }
            ]
        }
    ]
